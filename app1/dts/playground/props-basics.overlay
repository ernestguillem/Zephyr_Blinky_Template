/ {

  aliases {
    led1 = &yellow_led_1;
    led2 = &red_led_1;
    usrbtn = &user_button;
    mypwmalias = &pwm_device_0;
  };

  chosen {
  };

  pwm_devices{
    compatible = "pwm-leds";
    pwm_device_0: pwm_device_0 {
      pwms = <&pwm13 1 PWM_MSEC(1000) (PWM_POLARITY_NORMAL)>;
    };
  };

};

&usart3 {
  pinctrl-0 = <&usart3_tx_pc10 &usart3_rx_pc11>;
};

&timers13 {
  status = "okay";
  st,prescaler = <10000>;
  pwm13: pwm {
    pinctrl-0 = <&tim13_ch1_pf8>;
    pinctrl-names = "default";
    status = "okay";
  };
};
