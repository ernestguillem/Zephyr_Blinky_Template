/ {
  /* --------------------------------------------------
   * Aliases for easier reference in application code
   * -------------------------------------------------- */
  aliases {
    led1 = &yellow_led_1;       // Alias for yellow LED
    led2 = &red_led_1;          // Alias for red LED
    usrbtn = &user_button;      // Alias for user push button
    mypwmalias = &pwm_device_0; // Alias for custom PWM device
  };

  /* --------------------------------------------------
   * Chosen section (empty for now, but used for defaults)
   * Example: stdout, entropy-source, etc.
   * -------------------------------------------------- */
  chosen {
    // No defaults set yet
  };

  /* --------------------------------------------------
   * Logical container for PWM-driven devices (e.g. LEDs)
   * Uses the "pwm-leds" binding to represent PWM channels
   * since a custom container doesn't work due to a bug
   * -------------------------------------------------- */
  pwm_devices {
    compatible = "pwm-leds";
    pwm_device_0: pwm_device_0 {
      pwms = <&pwm13 1 PWM_MSEC(1000) (PWM_POLARITY_NORMAL)>;
    };
  };
};

/* --------------------------------------------------
 * USART3 configuration (for UART or serial)
 * Maps TX to PC10 and RX to PC11
 * -------------------------------------------------- */
&usart3 {
  pinctrl-0 = <&usart3_tx_pc10 &usart3_rx_pc11>;
};

/* --------------------------------------------------
 * TIM13 Timer peripheral setup for PWM
 * Enables the timer and configures PWM output on PF8
 * -------------------------------------------------- */
&timers13 {
  status = "okay";            // Enable timer 13
  st,prescaler = <10000>;     // Set hardware prescaler
  pwm13: pwm {
    pinctrl-0 = <&tim13_ch1_pf8>;    // Map channel 1 to pin PF8
    pinctrl-names = "default";
    status = "okay";
  };
};
